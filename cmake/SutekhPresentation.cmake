    foreach(cand "${SUTEKH_SDL3_INCLUDE_DIR}" "${SUTEKH_THIRD_PARTY_DIR}/sdl3/include")
        if(SUTEKH_SDL3_INCLUDE STREQUAL "" AND NOT cand STREQUAL "" AND EXISTS "${cand}/SDL3/SDL_version.h")
            set(SUTEKH_SDL3_INCLUDE "${cand}")
        endif()
    endforeach()
endif()
