    target_link_libraries(test_render_bloom PRIVATE su_render su_asset)
    sutekh_apply_warnings(test_render_bloom)
    add_test(NAME render_bloom COMMAND test_render_bloom)
    add_executable(test_render_texfx tests/render/test_render_texfx.c)
