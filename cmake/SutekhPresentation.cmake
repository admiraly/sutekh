    add_test(NAME render_offscreen COMMAND test_render_offscreen "${CMAKE_BINARY_DIR}/render_offscreen.ppm")
    set_tests_properties(render_offscreen PROPERTIES SKIP_RETURN_CODE 77)
    add_executable(test_render_haze tests/render/test_render_haze.c)
    add_executable(test_render_distortion tests/render/test_render_distortion.c)
    target_link_libraries(test_render_distortion PRIVATE su_render)
    sutekh_apply_warnings(test_render_distortion)
    add_test(NAME render_distortion COMMAND test_render_distortion)
    set_tests_properties(render_distortion PROPERTIES SKIP_RETURN_CODE 77)
    target_link_libraries(test_render_haze PRIVATE su_render)
