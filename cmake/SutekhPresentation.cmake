# Vulkan headers, first found: the pinned bootstrap checkout (tools/bootstrap_vulkan_headers.py; in SUTEKH_DEPS_DIR
# with --dest), an installed SDK (VULKAN_SDK), else system headers (e.g. /usr/include/vulkan from a distribution
# package) if they are at least SUTEKH_VULKAN_SYSTEM_MIN, the oldest release the renderer has been built and tested
# against. The loader is opened at run time, so nothing links against a Vulkan library. SUTEKH_RENDER=OFF skips the
# backend.
set(SUTEKH_RENDER "AUTO" CACHE STRING "Build the Vulkan renderer: AUTO (when headers are found), ON, OFF")
set(SUTEKH_VULKAN_SYSTEM_MIN "1.3.204")
set(SUTEKH_VULKAN_INCLUDE "")
set(sutekh_vk_rejected "")
if(NOT SUTEKH_RENDER STREQUAL "OFF")
    foreach(cand "${SUTEKH_THIRD_PARTY_DIR}/vulkan-headers/include" "$ENV{VULKAN_SDK}/Include" "$ENV{VULKAN_SDK}/include")
        if(SUTEKH_VULKAN_INCLUDE STREQUAL "" AND EXISTS "${cand}/vulkan/vulkan_core.h")
            set(SUTEKH_VULKAN_INCLUDE "${cand}")
        endif()
    endforeach()
    if(SUTEKH_VULKAN_INCLUDE STREQUAL "")
        find_path(SUTEKH_VULKAN_SYSTEM_INCLUDE vulkan/vulkan_core.h DOC "System Vulkan headers (Sutekh's last resort)")
        if(SUTEKH_VULKAN_SYSTEM_INCLUDE AND EXISTS "${SUTEKH_VULKAN_SYSTEM_INCLUDE}/vulkan/vulkan_core.h")
            # VK_HEADER_VERSION_COMPLETE is VK_MAKE_API_VERSION(0, major, minor, VK_HEADER_VERSION) since 1.2.175.
            file(STRINGS "${SUTEKH_VULKAN_SYSTEM_INCLUDE}/vulkan/vulkan_core.h" sutekh_vk_lines
                 REGEX "^#define VK_HEADER_VERSION(_COMPLETE)? ")
            set(sutekh_vk_version "")
            if(sutekh_vk_lines MATCHES "#define VK_HEADER_VERSION ([0-9]+)")
                set(sutekh_vk_patch "${CMAKE_MATCH_1}")
                if(sutekh_vk_lines MATCHES "VK_MAKE_API_VERSION\\( *0, *([0-9]+), *([0-9]+), *VK_HEADER_VERSION *\\)")
                    set(sutekh_vk_version "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${sutekh_vk_patch}")
                endif()
            endif()
            if(NOT sutekh_vk_version STREQUAL "" AND NOT sutekh_vk_version VERSION_LESS SUTEKH_VULKAN_SYSTEM_MIN)
                set(SUTEKH_VULKAN_INCLUDE "${SUTEKH_VULKAN_SYSTEM_INCLUDE}")
                message(STATUS "Sutekh renderer: system Vulkan headers ${sutekh_vk_version}")
            else()
                if(sutekh_vk_version STREQUAL "")
                    set(sutekh_vk_version "of unknown version")
                endif()
                set(sutekh_vk_rejected "system headers in ${SUTEKH_VULKAN_SYSTEM_INCLUDE} are ${sutekh_vk_version}, older than ${SUTEKH_VULKAN_SYSTEM_MIN}")
            endif()
            unset(sutekh_vk_lines)
            unset(sutekh_vk_patch)
            unset(sutekh_vk_version)
        endif()
    endif()
endif()
# The decision, visible to an add_subdirectory consumer ("" when no headers were found or SUTEKH_RENDER=OFF).
set(SUTEKH_VULKAN_INCLUDE_DIR "${SUTEKH_VULKAN_INCLUDE}" CACHE INTERNAL "Vulkan include directory Sutekh's renderer uses")
set(sutekh_vk_hint "run tools/bootstrap_vulkan_headers.py (--dest DIR with -DSUTEKH_DEPS_DIR=DIR), set VULKAN_SDK, or install Vulkan headers ${SUTEKH_VULKAN_SYSTEM_MIN} or later")
if(NOT sutekh_vk_rejected STREQUAL "")
    set(sutekh_vk_hint "${sutekh_vk_rejected}; ${sutekh_vk_hint}")
endif()
if(SUTEKH_RENDER STREQUAL "ON" AND SUTEKH_VULKAN_INCLUDE STREQUAL "")
