# Native build output and local tooling
/build/
/build-*/
/out/
/.cache/
/.venv/
__pycache__/
*.py[cod]

# Local secrets and proprietary game content
.env
.env.*
!.env.example
/local/
/local-assets/
/original-assets/

# Generated handoff archives
/SUTEKH_Engine_Specs_and_Prompts.zip

# AsmJit checkout fetched by tools/bootstrap_asmjit.py (third_party/asmjit.lock.json is tracked)
/third_party/asmjit/
# Vulkan-Headers checkout fetched by tools/bootstrap_vulkan_headers.py (third_party/vulkan-headers.lock.json is tracked)
/third_party/vulkan-headers/
# Single-file libraries fetched by tools/bootstrap_asset_deps.py (third_party/asset-deps.lock.json is tracked)
/third_party/cgltf/
/third_party/stb/
# SDL3 headers fetched by tools/bootstrap_sdl3_headers.py (third_party/sdl3-headers.lock.json is tracked)
/third_party/sdl3/
