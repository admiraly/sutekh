{
  "type": "object",
  "properties": {
    "report_format": {
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "specification_example_only",
        "runtime_evidence"
      ]
    },
    "status": {
      "enum": [
        "not_run",
        "running",
        "passed",
        "failed",
        "blocked",
        "inconclusive"
      ]
    },
    "source_tree_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "hardware": {
      "type": [
        "object",
        "null"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "measured",
              "not_run",
              "unavailable"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "value",
          "unit",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_run",
              "passed",
              "failed",
              "skipped",
              "unavailable"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "report_format",
    "kind",
    "status",
    "source_tree_hash",
    "artifact_hash",
    "hardware",
    "commands",
    "measurements",
    "checks",
    "notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sutekh:evidence:0.1"
}
