{
  "type": "object",
  "properties": {
    "capsule_format": {
      "const": "0.1"
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "system_rev": {
      "type": "integer",
      "minimum": 1,
      "description": "optional (M3-03a, OD-16); absent means the revision is not declared by the record"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "optional (M3-03a, OD-16); the capabilities the system uses, for example despawn_self (IR 0.2); absent means none"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "IR variant only (required there; refused in the host variant)"
    },
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "layout_generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version",
        "layout_generation"
      ],
      "additionalProperties": false
    },
    "numeric_profile": {
      "enum": [
        "u32_mod_v1",
        "fixed_q32_v1"
      ],
      "description": "u32_mod_v1 for ir_version 0.1 and 0.2; fixed_q32_v1 for 0.3 (checked by the verifier)"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "u32",
              "i32",
              "i64",
              "q32"
            ],
            "description": "u32 only below ir_version 0.3; i64 and q32 occupy ids id and id+1 (checked by the verifier)"
          },
          "read": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "read",
          "write"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024,
      "description": "IR variant only (required there; refused in the host variant)"
    },
    "host": {
      "type": "object",
      "description": "Host variant (M3-03a, OD-16; M3-04a). A host system is an operator compiled into the engine, not IR. Its declared field table must equal the operator descriptor exactly (checked by the loader).",
      "properties": {
        "operator": {
          "enum": [
            "rts_ops_v1",
            "rts_ops_v2",
            "space3d_ops_v1"
          ]
        },
        "operator_version": {
          "type": "integer",
          "minimum": 1
        },
        "constants_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 hex of the operator constants text"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.(lo|hi))?$",
                "description": "a typed 64-bit lane is named <field>.lo or <field>.hi"
              },
              "type": {
                "enum": [
                  "u32",
                  "i32",
                  "i64",
                  "q32"
                ],
                "description": "the lane's value type; u32 for every rts_ops lane"
              },
              "access": {
                "enum": [
                  "read",
                  "write",
                  "read_write"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "type",
              "access"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "required": [
        "operator",
        "operator_version",
        "constants_hash",
        "fields"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parallel": {
          "const": "serial"
        }
      },
      "required": [
        "phase",
        "after",
        "before",
        "parallel"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_instructions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "allocation": {
          "const": "forbidden"
        },
        "max_struct_per_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "IR 0.2 only (optional, default 0)"
        },
        "max_events_per_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "IR 0.2 only (optional, default 0)"
        }
      },
      "required": [
        "max_instructions",
        "max_rows",
        "allocation"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "ir_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3",
        "0.4"
      ],
      "description": "optional; absent means 0.1; must equal the IR ir_version. IR variant only"
    }
  },
  "required": [
    "capsule_format",
    "system_id",
    "schema",
    "numeric_profile",
    "schedule",
    "limits",
    "tests"
  ],
  "oneOf": [
    {
      "description": "IR variant: source, fields and ir_version apply; host is absent",
      "required": [
        "source",
        "fields"
      ],
      "not": {
        "required": [
          "host"
        ]
      }
    },
    {
      "description": "host variant: host is present; source, fields and ir_version are absent",
      "required": [
        "host"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "source"
            ]
          },
          {
            "required": [
              "fields"
            ]
          },
          {
            "required": [
              "ir_version"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sutekh:capsule:0.1"
}
